# HTTP listen port (compose port map). Default 8080.
HTTP_PORT=8080

# WebRTC media UDP port. Compose maps this to WACALLS_WEBRTC_UDP_PORT. Default 7881.
WEBRTC_UDP_PORT=7881

# Public IP/host the browser uses to reach this server (WebRTC 1:1 NAT).
# Required on bridge networking; empty = interface-IP candidates (LAN only).
WACALLS_PUBLIC_IP=

# Bearer token protecting /api and /debug. Empty = authentication OFF (LAN only).
# Clients send it as `Authorization: Bearer <token>`; the SSE stream uses `?access_token=`.
WACALLS_API_TOKEN=

# CORS: comma-separated allowlist of browser origins for a cross-origin frontend.
# Empty = same-origin only (no CORS headers). Example: https://calls.example.com
WACALLS_CORS_ORIGINS=

# Image/build tag label surfaced by the app.
VERSION=docker

# --- Storage backend (optional) ---
# Empty = SQLite (default, -db flag). Set DATABASE_URL to run everything on Postgres
# (app sessions + whatsmeow device store). pgx parses the URL; keep sslmode=disable for
# the bundled postgres service (no TLS). Switching an existing SQLite deploy to Postgres
# starts empty, so accounts must re-pair.
# DATABASE_URL=postgres://wacalls:wacalls@postgres:5432/wacalls?sslmode=disable
DATABASE_URL=
# Credentials for the bundled postgres service (docker-compose.postgres.yml):
POSTGRES_USER=wacalls
POSTGRES_PASSWORD=wacalls
POSTGRES_DB=wacalls

# --- Telemetry (optional, OpenTelemetry) ---
# Empty endpoint = telemetry OFF. Set to an OTLP/HTTP collector to export traces+metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wacalls
# Metric export interval in milliseconds (OTel SDK).
OTEL_METRIC_EXPORT_INTERVAL=3000
