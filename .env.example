# HTTP listen port (compose port map). Default 8080.
HTTP_PORT=8080

# WebRTC media UDP port. Compose maps this to WACALLS_WEBRTC_UDP_PORT. Default 7881.
WEBRTC_UDP_PORT=7881

# Public IP/host the browser uses to reach this server (WebRTC 1:1 NAT).
# Required on bridge networking; empty = interface-IP candidates (LAN only).
WACALLS_PUBLIC_IP=

# STUN servers the doctor queries to discover/verify the external public IP
# (comma-separated host:port). Empty = stun.l.google.com:19302,stun.cloudflare.com:3478.
WACALLS_STUN_SERVER=

# Single-admin login. REQUIRED to boot (both together): the UI signs in with these and gets an
# httpOnly session cookie; the SSE stream rides the same cookie. Change the password in the UI
# afterward (the hash lives in the DB and survives restarts, so you can clear these later).
WACALLS_ADMIN_USER=admin
WACALLS_ADMIN_PASSWORD=change-me

# Optional bearer token for automation/scripts (`Authorization: Bearer <token>`). Not needed for
# the UI (the login cookie covers it). Empty = no programmatic access, login only.
WACALLS_API_TOKEN=

# CORS: comma-separated allowlist of browser origins for a cross-origin frontend.
# Empty = same-origin only (no CORS headers). Example: https://calls.example.com
WACALLS_CORS_ORIGINS=

# Per-IP rate limit on /api, in requests per second (burst = 2x rps).
# Empty = default 20. Set 0 to disable.
WACALLS_RATE_LIMIT=

# Reverse proxy allowlist (comma-separated IPs/CIDRs, e.g. "172.16.0.0/12").
# When a request arrives FROM one of these, the per-IP rate limit keys by the
# real client in X-Forwarded-For (rightmost untrusted hop). Empty = off.
WACALLS_TRUSTED_PROXIES=

# --- Webhooks (optional) ---
# Signed POST on call lifecycle transitions (call.ringing / call.active / call.ended).
# Both must be set together: URL without secret fails the boot. Empty = webhooks OFF.
WACALLS_WEBHOOK_URL=
WACALLS_WEBHOOK_SECRET=

# --- Call diagnostics recorder (optional, support/dev) ---
# When set, mirrors each call's event timeline (status, quality, setup marks, relay,
# mute, end) to <dir>/call-<id>.jsonl for support tickets. Stores per-call metadata
# including peer numbers on disk (no keys, secrets, or media). Empty = OFF.
WACALLS_DIAG_DIR=

# Image/build tag label surfaced by the app.
VERSION=docker

# Published image to run. :latest is production, :develop is the beta channel.
# Empty uses the default (:latest).
WACALLS_IMAGE=

# --- Production deploy behind Traefik (docker-compose.traefik.yml) ---
# Domain that resolves to this server; Traefik issues a Let's Encrypt cert for it.
WACALLS_DOMAIN=
# Email for the Let's Encrypt account (expiry notices).
ACME_EMAIL=

# --- Storage backend (optional) ---
# Empty = SQLite (default, -db flag). Set DATABASE_URL to run everything on Postgres
# (app sessions + whatsmeow device store). pgx parses the URL; keep sslmode=disable for
# the bundled postgres service (no TLS). Switching an existing SQLite deploy to Postgres
# starts empty, so accounts must re-pair.
# DATABASE_URL=postgres://wacalls:wacalls@postgres:5432/wacalls?sslmode=disable
DATABASE_URL=
# Credentials for the bundled postgres service (docker-compose.postgres.yml):
POSTGRES_USER=wacalls
POSTGRES_PASSWORD=wacalls
POSTGRES_DB=wacalls

# --- Telemetry (optional, OpenTelemetry) ---
# Empty endpoint = telemetry OFF. Set to an OTLP/HTTP collector to export traces+metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wacalls
# Metric export interval in milliseconds (OTel SDK).
OTEL_METRIC_EXPORT_INTERVAL=3000
